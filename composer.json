{
  "name": "sitegeist/bitzer",
  "type": "neos-package",
  "description": "A content lifecycle task manager for Neos CMS",
  "require": {
    "php": "^8.2",
    "neos/neos": "~8.2",
    "neos/fusion": "~8.2",
    "neos/content-repository": "~8.2",
    "neos/fusion-afx": "~8.2",
    "doctrine/dbal": "*",
    "doctrine/migrations": "*",
    "neos/content-repository-dimensionspace": "1.0.x-dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.5",
    "neos/buildessentials": "^8.0",
    "mikey179/vfsstream": "^1.6",
    "squizlabs/php_codesniffer": "^3.6",
    "behat/behat": "^3.5"
  },
  "scripts": {
    "lint": "bin/phpcs --standard=PSR12 --extensions=php --exclude=PSR1.Files.SideEffects,Generic.Files.LineLength Classes/ Tests/",
    "analyse": "bin/phpstan analyse --level 8 Tests/Unit Classes",
    "test": "bin/phpunit -c phpunit.xml --enforce-time-limit --coverage-html Build/Reports/coverage Tests"
  },
  "autoload": {
    "psr-4": {
      "Sitegeist\\Bitzer\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sitegeist\\Bitzer\\Tests\\": "Tests"
    }
  },
  "config": {
    "vendor-dir": "Packages/Libraries",
    "bin-dir": "bin",
    "allow-plugins": {
      "neos/composer-plugin": true
    }
  }
}
